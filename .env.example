# ==============================================================================
# Techonomy Root Environment Configuration Template (.env.example)
# Copy this file to .env at the root of the repository before running Docker.
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO GIT HISTORY.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED API CREDENTIALS & SECRETS
# ------------------------------------------------------------------------------
# Primary LLM API Key (Gemini 2.0 Flash)
GEMINI_API_KEY="your-gemini-api-key-here"

# Fallback LLM API Key (OpenRouter / Nemotron 3.5)
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Security Secret for JWT Authentication
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (TWO MODES SUPPORTED)
# ------------------------------------------------------------------------------
# MODE A (Default - Local Docker PostgreSQL):
# Leave DATABASE_URL commented out or set to local container URL:
DATABASE_URL="postgresql://techonomy:techonomy_pass@postgres:5432/techonomy_db"

# MODE B (College Event Deployment - Supabase Cloud PostgreSQL):
# Uncomment and set your active Supabase connection string:
# DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"

# Local PostgreSQL Docker Container Credentials (Only used in Mode A)
POSTGRES_DB="techonomy_db"
POSTGRES_USER="techonomy"
POSTGRES_PASSWORD="techonomy_pass"

# ------------------------------------------------------------------------------
# 3. VECTOR DATABASE (QDRANT) CONFIGURATION
# ------------------------------------------------------------------------------
# In Docker Compose, QDRANT_HOST defaults to the container service name "qdrant"
QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="company_knowledge"
QDRANT_STORAGE_PATH="./qdrant_storage"

# ------------------------------------------------------------------------------
# 4. NETWORK & LAN BINDING CONFIGURATION
# ------------------------------------------------------------------------------
HOST="0.0.0.0"
PORT=8000

# Backend CORS Allowed Origins (Comma-separated or JSON list)
# For local development:
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# For College Event LAN Deployment:
# CORS_ORIGINS="http://localhost:3000,http://192.168.1.50:3000"

# Frontend Backend API Target URL
# For local development:
VITE_API_BASE_URL="http://localhost:8000"
# For College Event LAN Deployment:
# VITE_API_BASE_URL="http://192.168.1.50:8000"
