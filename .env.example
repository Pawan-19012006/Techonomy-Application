# Techonomy / KAIROS Root Environment Configuration Template

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=techonomy
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/techonomy

# Qdrant Vector Store Configuration
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COMPANY_COLLECTION_NAME=company_knowledge
QDRANT_INSTRUCTION_COLLECTION_NAME=instruction_knowledge

# LLM Gateway API Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
