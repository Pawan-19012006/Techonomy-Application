# Application settings
PROJECT_NAME="Techonomy"
VERSION="0.1.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security (JWT)
JWT_SECRET="generate-a-secure-random-key-for-production"
JWT_ALGORITHM="HS256"

# Event Configuration
QUESTION_LIMIT=10

# LLM / OpenRouter
OPENROUTER_API_KEY=""
MODEL_NAME="cohere/north-mini-code:free"

# RAG / Retrieval
TOP_K=5

# Relational Database
DATABASE_URL="sqlite:///./techonomy.db"

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
