# Application settings
PROJECT_NAME="Techonomy Knowledge Intelligence Platform"
VERSION="1.0.0"
DEBUG=True
HOST="0.0.0.0"
PORT=8000

# Security (JWT)
JWT_SECRET="generate-a-secure-random-key-for-production"
JWT_ALGORITHM="HS256"

# Event Configuration
QUESTION_LIMIT=10

# LLM / OpenRouter Provider
OPENROUTER_API_KEY="your-openrouter-api-key-here"
PRIMARY_MODEL="nvidia/nemotron-3.5-lightning:free"
FALLBACK_MODEL="meta-llama/llama-3.2-3b-instruct:free"

# RAG / Retrieval Configuration
RETRIEVAL_TOP_K=10
RETRIEVAL_RERANK_TOP_N=5

# Relational Database (Supabase PostgreSQL)
DATABASE_URL="postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Vector Database (Qdrant)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="company_knowledge"
