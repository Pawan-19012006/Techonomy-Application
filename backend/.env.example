# =====================================================================
# TECHONOMY BACKEND ENVIRONMENT CONFIGURATION (.env)
# =====================================================================
# Copy this file to backend/.env and replace placeholders with actual credentials.
#
# DO NOT COMMIT REAL CREDENTIALS TO GIT REPOSITORIES.
# =====================================================================

# ---------------------------------------------------------------------
# 1. APPLICATION & SERVER CONFIGURATION
# ---------------------------------------------------------------------
# Name of the application displayed in status and documentation endpoints.
PROJECT_NAME="Techonomy Knowledge Intelligence Platform"
# Set DEBUG to False in production.
DEBUG=False
# Network interface host binding (0.0.0.0 for Docker container binding).
HOST=0.0.0.0
# Port on which FastAPI listens inside the container.
PORT=8000
# Secret key used for signing JWT tokens and securing sessions (SECRET).
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_here
# Allowed CORS origins (comma-separated or JSON list).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# 2. PERSISTENT DATABASE CONFIGURATION (Supabase / PostgreSQL)
# ---------------------------------------------------------------------
# PostgreSQL connection string for Supabase or local PostgreSQL (SECRET).
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://techonomy:techonomy_pass@postgres:5432/techonomy_db

# ---------------------------------------------------------------------
# 3. VECTOR DATABASE CONFIGURATION (Qdrant Cloud / Local Fallback)
# ---------------------------------------------------------------------
# Qdrant Cloud HTTPS Cluster URL (SECRET). Leave empty to use local container/disk.
QDRANT_URL=https://your-cluster-id.qdrant.tech
# Qdrant Cloud API Key (SECRET). Leave empty if using unauthenticated local Qdrant.
QDRANT_API_KEY=your_qdrant_cloud_api_key_here
# Host and port for local Qdrant container fallback.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
# Name of the Qdrant vector collection storing event knowledge.
QDRANT_COLLECTION_NAME=company_knowledge

# ---------------------------------------------------------------------
# 4. LLM PROVIDER CREDENTIALS (Gemini Primary & OpenRouter Fallback)
# ---------------------------------------------------------------------
# Google Gemini API Key for primary LLM generation lane (SECRET).
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Model identifier for primary Gemini generation.
GEMINI_MODEL=gemini-flash-lite-latest

# OpenRouter API Key for fallback Nemotron/Llama LLM lane (SECRET).
# Obtain from OpenRouter Dashboard: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model identifier for fallback OpenRouter generation.
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# ---------------------------------------------------------------------
# 5. EMBEDDING & RETRIEVAL CONFIGURATION
# ---------------------------------------------------------------------
# HuggingFace model identifier for local CPU dense text embeddings.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
# Number of relevant chunks retrieved per query.
RETRIEVAL_TOP_K=10
