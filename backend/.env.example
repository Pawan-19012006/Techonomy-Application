# ==============================================================================
# Techonomy Backend Environment Configuration Template (.env.example)
# Copy this file to .env on the deployment laptop before starting the server.
# DO NOT COMMIT ACTUAL API KEYS OR SECRETS TO GIT HISTORY.
# ==============================================================================

# Application & Network Binding
PROJECT_NAME="Techonomy Knowledge Intelligence Platform"
VERSION="1.0.0"
DEBUG=False
HOST="0.0.0.0"
PORT=8000
API_PREFIX="/api"

# CORS Configuration for College Event LAN
# Set to comma-separated URLs or JSON array of allowed origins (e.g. frontend laptop IP).
# Example for deployment: CORS_ORIGINS=http://localhost:3000,http://192.168.1.50:3000
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173"

# Relational Database (Authoritative Supabase PostgreSQL)
# Must contain active connection string on deployment laptop.
DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require"
SQL_ECHO=False

# Primary LLM API Credentials (Gemini 2.0 Flash)
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_ENABLED=True
GEMINI_TEST_REQUEST_LIMIT=3
GEMINI_MAX_CONCURRENT_REQUESTS=1
GEMINI_NUM_LANES=10

# Fallback LLM API Credentials (OpenRouter / Nemotron)
OPENROUTER_API_KEY="your-openrouter-api-key-here"
NEMOTRON_ENABLED=True
NEMOTRON_TEST_REQUEST_LIMIT=3
NEMOTRON_MAX_CONCURRENT_REQUESTS=1
NEMOTRON_NUM_LANES=10
PRIMARY_MODEL="nvidia/nemotron-3.5-lightning:free"
FALLBACK_MODEL="meta-llama/llama-3.2-3b-instruct:free"

# Quota Scheduler Parameters
SCHEDULER_COOLDOWN_SECONDS=60.0

# Vector Database (Qdrant) Configuration
# Tries live Qdrant host/port first; falls back automatically to local disk QDRANT_STORAGE_PATH if server offline.
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="company_knowledge"
QDRANT_STORAGE_PATH="./qdrant_storage"

# Security Secrets
JWT_SECRET="replace-with-a-secure-random-jwt-secret-key"

# Knowledge Indexing & Model Caching
EMBEDDING_MODEL_NAME="BAAI/bge-small-en-v1.5"
EMBEDDING_BATCH_SIZE=32
