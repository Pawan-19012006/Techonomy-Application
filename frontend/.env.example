# =====================================================================
# TECHONOMY FRONTEND ENVIRONMENT CONFIGURATION (.env)
# =====================================================================
# In production single-port deployment (FastAPI serving React on port 8000),
# leave VITE_API_BASE_URL empty so the frontend uses same-origin relative URLs.
#
# Only set VITE_API_BASE_URL during standalone Vite development if calling a
# separate backend host (e.g. http://localhost:8000).
# =====================================================================

VITE_API_BASE_URL=
